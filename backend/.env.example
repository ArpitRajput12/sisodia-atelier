# ==============================================================================
# SISODIYA CRAFT - BACKEND ENVIRONMENT CONFIGURATION
# Ultra-Luxury Heirloom Solid Wood Handicrafts (Global & Domestic)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://sisodiyacraft.com

# Neon PostgreSQL Database URLs
# DATABASE_URL: Neon pooled connection string (PgBouncer) for high-concurrency queries
# DIRECT_URL: Direct unpooled connection string for Prisma migrations
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="sisodiya_luxury_heirloom_access_secret_key_2026_secure"
JWT_REFRESH_SECRET="sisodiya_luxury_heirloom_refresh_secret_key_2026_secure"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Supported Currencies (Default: INR for domestic, USD for global patron views)
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=INR,USD,GBP,EUR,AED

# Concierge & Atelier Notification Email
ATELIER_CONCIERGE_EMAIL="concierge@sisodiyacraft.com"
SENDER_EMAIL="concierge@sisodiyacraft.com"

# Payment Gateways (Stripe, Razorpay, PayPal)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
PAYPAL_CLIENT_ID="A..."
PAYPAL_CLIENT_SECRET="E..."
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"

# Multi-Provider AI Engine (Switch between: gemini | claude | openai | groq | openrouter)
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL=""

# Provider-Specific Fallback Keys (Alternative to AI_API_KEY)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Resend Transactional Email API
RESEND_API_KEY=""

# Yash Sisodia Founder Desk Passcode
OWNER_PASSCODE="1234"

# Cloudinary Media Storage (Images & Documentary Reels)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

